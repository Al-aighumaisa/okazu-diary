{
  "name": "@okazu-diary/api",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "description": "Client library for Okazu-Diary.org Lexicon.",
  "author": {
    "name": "مرزم اليَغميصاء",
    "email": "al.aighumaisa@gmail.com"
  },
  "keywords": [
    "atproto",
    "okazu-diary.org"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Al-aighumaisa/okazu-diary.git",
    "directory": "packages/api"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run prebuild && tsc --build tsconfig.json",
    "codegen": "lex build --lib '@atproto/lex-schema' --lexicons ../../lexicons --clear && find src/lexicons -name '*.defs.ts' -exec sh -c 'f=\"$(sed -E \"s|export \\* from (.*)|&\\nexport type * from \\1|\" \"${1%.defs.ts}.ts\")\" && printf %s \"$f\" > \"${1%.defs.ts}.ts\"' - {} \\;",
    "prebuild": "pnpm run codegen"
  },
  "dependencies": {
    "@atproto/lex-schema": "^0.2.5",
    "@atproto/lexicon": "^0.7"
  },
  "devDependencies": {
    "@atproto/lex": "^0.3.5"
  }
}
