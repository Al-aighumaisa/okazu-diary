exports[`resolve snapshot illust-updated (34231632) 1`] = `
{
  "creator": [
    {
      "image": {
        "contentUrl": "https://i.pixiv.cat/user-profile/img/2025/01/28/14/59/33/26898736_058dfc75acb3b71f4cdce3fdb7a9da87_50.jpg",
