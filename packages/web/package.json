{
  "name": "@okazu-diary/web",
  "description": "Single-user profile viewer for the Okazu-Diary.org Lexicon.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prebuild && react-router build",
    "dev": "OKAZU_DIARY_WEB_BASE_URL=http://[::1]:5173 pnpm run prebuild && node ./scripts/dev-env.mjs react-router dev --mode=development --host=::1 --port=:5173",
    "prebuild": "node ./scripts/generate-metadata.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --build --noEmit"
  },
  "dependencies": {
    "@atcute/did-plc": "^1",
    "@atproto/did": "^0.5",
    "@atproto/identity": "^0.5",
    "@atproto/lex-cbor": "^0.1",
    "@atproto/lex-client": "^0.3",
    "@atproto/lex-data": "^0.1.7",
    "@atproto/lex-schema": "^0.2.5",
    "@atproto/lexicon": "^0.7",
    "@atproto/oauth-client-browser": "^0.5",
    "@atproto/syntax": "^0.7.4",
    "@atproto/xrpc": "^0.8",
    "@okazu-diary/api": "workspace:^",
    "@react-router/node": "^7.14.0",
    "@react-router/serve": "^7.14.0",
    "@tanstack/react-query": "^5.100.9",
    "fast-equals": "^6.0.0",
    "i18next": "^25.10.10",
    "isbot": "^5.1.37",
    "local-storage-fallback": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^10.0.3",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^7.14.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@atproto/common-web": "^0.5",
    "@atproto/crypto": "^0.5",
    "@atproto/dev-env": "^0.5",
    "@atproto/repo": "^0.10",
    "@atproto/xrpc-server": "^0.12",
    "@did-plc/lib": "^0.0.4",
    "@react-router/dev": "^7.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.0.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
